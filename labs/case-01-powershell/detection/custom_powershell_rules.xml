<group name='windows,powershell,custom_detection,'>
	<rule id='100110' level='8'>
		<if_sid>91802</if_sid>
		<field name='win.system.eventID'>^4104$</field>
		<field name='win.eventdata.scriptBlockText' type='pcre2'>(?i)(\biex\b|Invoke-Expression|(?:gcm|Get-Command)\s*\(\s*['"][^'"]*\{[0-9]+\}['"]\s*-f)</field>
		<description>Suspicious PowerShell command execution or obfuscation</description>
		<mitre>
			<id>T1059.001</id>
		</mitre>
	</rule>
</group>